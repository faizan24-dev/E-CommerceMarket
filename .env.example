# Copy this file to .env and fill in real values. Never commit .env.

# One server runs the website and the Express API (see server.js)
PORT=3000
# Comma-separated origins allowed to call /api from another domain (same-origin calls always work)
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommercemarket?retryWrites=true&w=majority
DB_NAME=ecommercemarket

# Auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d
