# Copy this file to .env and fill in real values. Never commit .env.
# On Vercel, add the same variables under Project -> Settings -> Environment Variables.

# ---- Database ----------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommercemarket?retryWrites=true&w=majority
DB_NAME=ecommercemarket

# ---- Security ----------------------------------------------------------------
# Encrypts seller bank/wallet details at rest. 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable: changing it makes previously saved payout details unreadable.
ENCRYPTION_KEY=replace-with-64-hex-characters

# How long a login lasts without activity (days). Active users are extended automatically.
SESSION_TTL_DAYS=14

# ---- Payments ----------------------------------------------------------------
# manual:    buyers pay by bank transfer and you confirm each payment in /admin/orders.
# simulated: orders are marked paid instantly. Local development only; refused in production
#            unless ALLOW_SIMULATED_PAYMENTS=true.
PAYMENT_MODE=manual
# Shown to buyers on unpaid orders. Put your bank details here.
PAYMENT_INSTRUCTIONS="Send the order total to: Account title ... | Bank ... | IBAN ... Then enter the transaction reference below."

# ---- First admin (used only by `npm run seed:admin`) -------------------------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-unique-password
ADMIN_NAME=Store Admin
